
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // A user can read their own doc, and write to it.
      allow read, write: if request.auth.uid == userId;
    }

    match /units/{unitId} {
      // READ: A user can read a unit if they are the lecturer,
      // or if their user document's 'enrolledUnitIds' array contains the unitId.
      allow read: if request.auth != null &&
        (
          resource.data.lecturerId == request.auth.uid ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            'enrolledUnitIds' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
            unitId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enrolledUnitIds
          )
        );

      // CREATE: The creating user must set themselves as the lecturerId.
      allow create: if request.auth.uid == request.resource.data.lecturerId;

      // UPDATE: Allow if the user is the lecturer, OR if a student is adding themselves
      // to the enrolledStudents array during the join transaction.
      allow update: if request.auth.uid == resource.data.lecturerId ||
                     (
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolledStudents']) &&
                       request.resource.data.enrolledStudents.size() == resource.data.enrolledStudents.size() + 1 &&
                       request.auth.uid in request.resource.data.enrolledStudents
                     );

      // DELETE: Only the owner (lecturer) can delete a unit.
      allow delete: if request.auth.uid == resource.data.lecturerId;

      match /attendance/{attendanceId} {
        // Attendance records are immutable once created.
        allow update, delete: if false;

        // GET: A lecturer can get any record in their unit. A student can get their own record.
        allow get: if request.auth != null &&
                     (
                       get(/databases/$(database)/documents/units/$(unitId)).data.lecturerId == request.auth.uid ||
                       resource.data.studentId == request.auth.uid
                     );
        
        // LIST: Allow a user to query attendance if they are the lecturer OR if they are enrolled in the unit.
        // This rule is safe because the frontend query for students MUST include `where("studentId", "==", request.auth.uid)`.
        allow list: if request.auth != null &&
                    (
                       get(/databases/$(database)/documents/units/$(unitId)).data.lecturerId == request.auth.uid ||
                       (
                         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                         'enrolledUnitIds' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
                         unitId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enrolledUnitIds
                       )
                    );


        // CREATE: Allow if user is enrolled student or lecturer.
        allow create: if request.auth != null &&
                       (
                         // Student creating their own record
                         (
                           request.resource.data.studentId == request.auth.uid &&
                           // Check enrollment by looking at the user's own document, which is more reliable
                           (
                              exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                              'enrolledUnitIds' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
                              unitId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enrolledUnitIds
                           )
                         ) ||
                         // Lecturer creating a record (manual sign-in)
                         (
                           get(/databases/$(database)/documents/units/$(unitId)).data.lecturerId == request.auth.uid
                         )
                       );
      }
    }
  }
}
