
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isUnitOwner(unitId) {
      // exists() is not strictly necessary but adds robustness against race conditions
      return request.auth != null &&
             exists(/databases/$(database)/documents/units/$(unitId)) &&
             get(/databases/$(database)/documents/units/$(unitId)).data.lecturerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /units/{unitId} {
      // READ: Explicitly allow 'get' and 'list' for any authenticated user.
      // This is safe because client-side queries are used to filter data
      // appropriately for lecturers and students.
      allow get: if request.auth != null;
      allow list: if request.auth != null;

      // CREATE: The creating user must be a lecturer and set themselves as the owner.
      allow create: if request.auth != null
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'lecturer'
                    && request.resource.data.lecturerId == request.auth.uid;

      // UPDATE: Only the owner (lecturer) can update the main unit document.
      allow update: if isUnitOwner(unitId);
        
      // DELETE: Only the owner (lecturer) can delete.
      allow delete: if isUnitOwner(unitId);
      
      match /enrolledStudents/{studentId} {
        // A student can create their own enrollment document.
        allow create: if request.auth.uid == studentId;
        
        // A student can read their own enrollment, a lecturer can read any in their unit.
        allow get: if isUnitOwner(unitId) || request.auth.uid == studentId;
        
        // Only a lecturer can list all students in their unit.
        allow list: if isUnitOwner(unitId);
        
        // Only the lecturer can un-enroll a student.
        allow delete: if isUnitOwner(unitId);
      }

      match /attendance/{attendanceId} {
        
        // A lecturer can get any record in their unit. A student can get their own record.
        allow get: if request.auth != null && (
          isUnitOwner(unitId) ||
          (resource.data.studentId == request.auth.uid)
        );

        // Lecturers can list all records. Students can list ONLY their own records.
        allow list: if request.auth != null && (
            isUnitOwner(unitId) ||
            (request.query.where.size() == 1 &&
             request.query.where[0][0] == 'studentId' &&
             request.query.where[0][1] == '==' &&
             request.query.where[0][2] == request.auth.uid)
          );

        // Students can create a PENDING record if enrolled. Lecturers can manually add a record.
        allow create: if (
            (
              request.auth.uid == request.resource.data.studentId &&
              exists(/databases/$(database)/documents/units/$(unitId)/enrolledStudents/$(request.auth.uid))
            ) || isUnitOwner(unitId)
        );
        
        // Only the unit owner (lecturer) can update the status from PENDING.
        allow update: if isUnitOwner(unitId) &&
                   request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
                   resource.data.status == 'PENDING' &&
                   request.resource.data.status in ['APPROVED', 'REJECTED'];
        
        // Only the unit owner can delete.
        allow delete: if isUnitOwner(unitId);
      }
    }
  }
}
