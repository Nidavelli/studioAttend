
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the requesting user is the owner of the unit.
    // This no longer checks the 'role' field, avoiding a cross-collection get().
    function isUnitOwner(unitId) {
      return request.auth != null && get(/databases/$(database)/documents/units/$(unitId)).data.lecturerId == request.auth.uid;
    }

    // Allow any authenticated user to read user profiles, but only allow a user to write to their own.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Rules for the 'units' collection
    match /units/{unitId} {
      // GET: A user can get a unit if they are the lecturer OR they are enrolled.
      allow get: if request.auth != null && 
                    (
                      resource.data.lecturerId == request.auth.uid ||
                      request.auth.uid in resource.data.enrolledStudents
                    );
      
      // LIST: A user can query units if they are querying for units where they are the lecturer
      // OR units where they are enrolled. This secures the two main queries in the app.
      allow list: if request.auth != null &&
                   (
                     request.query.where.size() > 0 &&
                     (
                       (request.query.where[0] == "lecturerId" && request.query.where[2] == request.auth.uid) ||
                       (request.query.where[0] == "enrolledStudents" && request.query.where[1] == "array-contains" && request.query.where[2] == request.auth.uid)
                     )
                   );

      // CREATE: The creating user must set themselves as the lecturerId.
      // This is safe because the client-side UI prevents non-lecturers from even seeing the create button.
      allow create: if request.auth != null
                    && request.resource.data.lecturerId == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.code is string
                    && request.resource.data.attendanceThreshold is number
                    && request.resource.data.enrolledStudents.size() == 0
                    && request.resource.data.sessionHistory.size() == 0;

      // UPDATE: Allow if the user is the owner (lecturer), OR if it's a student self-enrolling.
      allow update: if
        (
          // Lecturer can update their own unit
          get(/databases/$(database)/documents/units/$(unitId)).data.lecturerId == request.auth.uid
        ) || (
          // Student can only add themselves to the enrolledStudents list.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolledStudents']) &&
          request.resource.data.enrolledStudents.size() == resource.data.enrolledStudents.size() + 1 &&
          request.auth.uid in request.resource.data.enrolledStudents
        );
        
      // DELETE: Only the owner (lecturer) can delete.
      allow delete: if get(/databases/$(database)/documents/units/$(unitId)).data.lecturerId == request.auth.uid;

      // Rules for the nested 'attendance' sub-collection
      match /attendance/{attendanceId} {
        
        // GET: A lecturer can get any record in their unit. A student can only get their own record.
        allow get: if request.auth != null && (isUnitOwner(unitId) || resource.data.studentId == request.auth.uid);

        // LIST: The unit owner can list all records. Students can list their own records via query.
        allow list: if isUnitOwner(unitId) || 
                      (
                        request.query.where.size() > 0 &&
                        request.query.where[0] == "studentId" &&
                        request.query.where[2] == request.auth.uid
                      );

        // CREATE: Students can create a PENDING record for an ACTIVE session.
        // Lecturers can manually add a record.
        allow create: if (
            // STUDENT condition
            request.auth != null &&
            request.resource.data.studentId == request.auth.uid &&
            request.auth.uid in get(/databases/$(database)/documents/units/$(unitId)).data.enrolledStudents &&
            request.resource.data.sessionId == get(/databases/$(database)/documents/units/$(unitId)).data.activeSessionId &&
            request.resource.data.status == 'PENDING'
        ) || (
            // LECTURER condition for manual sign-in
            isUnitOwner(unitId) && request.resource.data.signInMethod == 'manual'
        );
        
        // UPDATE: Only the unit owner can update status.
        allow update: if isUnitOwner(unitId) &&
                   request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
                   resource.data.status == 'PENDING' &&
                   request.resource.data.status in ['APPROVED', 'REJECTED'];
        
        // DELETE: Only the unit owner can delete.
        allow delete: if isUnitOwner(unitId);
      }
    }
  }
}
