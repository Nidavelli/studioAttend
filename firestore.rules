rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isUnitOwner(unitId) {
      // isUnitOwner checks if the requesting user is the lecturer for the given unit.
      return request.auth != null &&
             get(/databases/$(database)/documents/units/$(unitId)).data.lecturerId == request.auth.uid;
    }

    match /users/{userId} {
      // Allow any authenticated user to read user profiles (needed for lecturer to see student names).
      allow read: if request.auth != null;
      // A user can only write to their own profile.
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /units/{unitId} {
      // Allow any authenticated user to get or list units.
      // This is necessary for students to find units by code and for general app functionality.
      allow get: if request.auth != null;
      allow list: if request.auth != null;

      // Only lecturers can create units.
      allow create: if request.auth != null
                    && request.resource.data.lecturerId == request.auth.uid;
        
      // Only the owner can update the main unit document.
      allow update: if isUnitOwner(unitId);
        
      // Only the owner can delete.
      allow delete: if isUnitOwner(unitId);
      
      match /enrolledStudents/{studentId} {
        // A student can get their own enrollment doc. A lecturer can read any.
        allow get: if isUnitOwner(unitId) || request.auth.uid == studentId;
        
        // Allow any authenticated user to perform list queries.
        // The app's logic will filter these queries securely for the current user.
        allow list: if request.auth != null;
        
        // A student can only create an enrollment document for themselves.
        allow create: if request.auth.uid == studentId
                      && request.resource.data.studentId == studentId;
        
        // Only the lecturer can un-enroll a student.
        allow delete: if isUnitOwner(unitId);
      }

      match /attendance/{attendanceId} {
        
        // GET: A lecturer can get any record. A student can get their own.
        allow get: if request.auth != null && (
          isUnitOwner(unitId) ||
          (resource.data.studentId == request.auth.uid)
        );

        // LIST: Allow any authenticated user to perform list queries.
        // The student-side query is secured with a `where("studentId", "==", ...)` clause in the app.
        allow list: if request.auth != null;

        // CREATE: Simplified rule. The main security check is that the user is enrolled.
        allow create: if (
            // STUDENT condition: Must be enrolled.
            request.auth != null &&
            request.resource.data.studentId == request.auth.uid &&
            exists(/databases/$(database)/documents/units/$(unitId)/enrolledStudents/$(request.auth.uid))
        ) || (
            // LECTURER condition (for manual add).
            isUnitOwner(unitId)
        );
        
        // UPDATE: Only the unit owner can update status from PENDING.
        allow update: if isUnitOwner(unitId) &&
                   request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
                   resource.data.status == 'PENDING' &&
                   request.resource.data.status in ['APPROVED', 'REJECTED'];
        
        // DELETE: Only the unit owner can delete.
        allow delete: if isUnitOwner(unitId);
      }
    }
  }
}
