
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is a lecturer and owns the unit.
    function isLecturerAndOwner(unitId) {
      let userRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      let unitLecturerId = get(/databases/$(database)/documents/units/$(unitId)).data.lecturerId;
      return request.auth != null && userRole == 'lecturer' && unitLecturerId == request.auth.uid;
    }

    // Allow any authenticated user to read user profiles, but only allow a user to write to their own.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Rules for the 'units' collection
    match /units/{unitId} {
      // Anyone authenticated can read unit information.
      allow read: if request.auth != null;

      // Only lecturers can create new units, and they must be the owner.
      allow create: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'lecturer'
                    && request.resource.data.lecturerId == request.auth.uid;

      // Lecturers can update their own units.
      // Students can ONLY update a unit to add themselves to the enrolledStudents list.
      allow update: if
        (
          isLecturerAndOwner(unitId)
        ) || (
          // Condition for Students: Allow update only for self-enrollment.
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolledStudents']) &&
          request.resource.data.enrolledStudents.size() == resource.data.enrolledStudents.size() + 1 &&
          request.auth.uid in request.resource.data.enrolledStudents
        );
        
      // Lecturers can delete their own units.
      allow delete: if isLecturerAndOwner(unitId);

      // Rules for the nested 'attendance' sub-collection
      match /attendance/{attendanceId} {
        // A user can read a record if they are the lecturer of the unit,
        // OR if the record belongs to them.
        allow read: if
          isLecturerAndOwner(unitId)
          ||
          (resource.data.studentId == request.auth.uid);

        // CREATE: Students can only sign-in for an ACTIVE session.
        // Lecturers can manually add attendance for any HISTORICAL session.
        allow create: if (
            // STUDENT condition: Must be enrolled, signing in for self, and for the currently active session.
            request.auth != null &&
            request.resource.data.studentId == request.auth.uid &&
            request.auth.uid in get(/databases/$(database)/documents/units/$(unitId)).data.enrolledStudents &&
            request.resource.data.sessionId == get(/databases/$(database)/documents/units/$(unitId)).data.activeSessionId
        ) || (
            // LECTURER condition: Must be the owner and the session must exist in history.
            isLecturerAndOwner(unitId) &&
            request.resource.data.sessionId in get(/databases/$(database)/documents/units/$(unitId)).data.sessionHistory
        );
        
        // Allow deletion of attendance records by the unit owner.
        allow update: if false;
        allow delete: if isLecturerAndOwner(unitId);
      }
    }
  }
}
