
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isUnitOwner(unitId) {
      return request.auth != null && get(/databases/$(database)/documents/units/$(unitId)).data.lecturerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /units/{unitId} {
      // READ: A user can read a unit if they are the lecturer OR they are enrolled.
      // This single rule covers both get() and list() queries securely.
      allow read: if request.auth != null && 
                    (
                      resource.data.lecturerId == request.auth.uid ||
                      request.auth.uid in resource.data.enrolledStudents
                    );

      // CREATE: The creating user must set themselves as the lecturerId and initialize fields.
      allow create: if request.auth != null
                    && request.resource.data.lecturerId == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.code is string
                    && request.resource.data.attendanceThreshold is number
                    && request.resource.data.enrolledStudents.size() == 0
                    && request.resource.data.sessionHistory.size() == 0;

      // UPDATE: Allow if the user is the owner (lecturer), OR if it's a student self-enrolling.
      allow update: if
        (
          // Lecturer can update their own unit
          get(/databases/$(database)/documents/units/$(unitId)).data.lecturerId == request.auth.uid
        ) || (
          // Student can only add themselves to the enrolledStudents list.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolledStudents']) &&
          request.resource.data.enrolledStudents.size() == resource.data.enrolledStudents.size() + 1 &&
          request.auth.uid in request.resource.data.enrolledStudents
        );
        
      // DELETE: Only the owner (lecturer) can delete.
      allow delete: if get(/databases/$(database)/documents/units/$(unitId)).data.lecturerId == request.auth.uid;

      // Rules for the nested 'attendance' sub-collection
      match /attendance/{attendanceId} {
        
        // READ: A lecturer can read any record in their unit. A student can only read their own record.
        allow read: if request.auth != null && (isUnitOwner(unitId) || resource.data.studentId == request.auth.uid);

        // CREATE: Students can create a PENDING record for an ACTIVE session.
        // Lecturers can manually add a record.
        allow create: if (
            // STUDENT condition
            request.auth != null &&
            request.resource.data.studentId == request.auth.uid &&
            request.auth.uid in get(/databases/$(database)/documents/units/$(unitId)).data.enrolledStudents &&
            request.resource.data.sessionId == get(/databases/$(database)/documents/units/$(unitId)).data.activeSessionId &&
            request.resource.data.status == 'PENDING'
        ) || (
            // LECTURER condition for manual sign-in
            isUnitOwner(unitId) && request.resource.data.signInMethod == 'manual'
        );
        
        // UPDATE: Only the unit owner can update status.
        allow update: if isUnitOwner(unitId) &&
                   request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
                   resource.data.status == 'PENDING' &&
                   request.resource.data.status in ['APPROVED', 'REJECTED'];
        
        // DELETE: Only the unit owner can delete.
        allow delete: if isUnitOwner(unitId);
      }
    }
  }
}
