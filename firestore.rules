
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    match /units/{unitId} {
      // READ: Allow any authenticated user to read public unit data.
      // This is required for students to query units by code before enrolling.
      allow read: if request.auth != null;

      // CREATE: Only lecturers can create units.
      allow create: if request.auth != null &&
        request.resource.data.lecturerId == request.auth.uid;

      // UPDATE: Only the unit owner (lecturer) can update.
      allow update: if request.auth != null &&
        get(/databases/$(database)/documents/units/$(unitId)).data.lecturerId == request.auth.uid;

      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/units/$(unitId)).data.lecturerId == request.auth.uid;

      match /enrolledStudents/{studentId} {
        // Allow a user to read their own enrollment document.
        allow get: if request.auth.uid == studentId;
        // Allow a lecturer to read any enrollment document in their unit.
        allow read: if get(/databases/$(database)/documents/units/$(unitId)).data.lecturerId == request.auth.uid;

        // Allow a user to enroll themselves.
        allow create: if request.auth.uid == studentId;

        // Only a lecturer can un-enroll a student.
        allow delete: if get(/databases/$(database)/documents/units/$(unitId)).data.lecturerId == request.auth.uid;
      }
      
      match /attendance/{attendanceId} {
        // READ: Allow if user is the lecturer of the unit OR it's their own record.
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/units/$(unitId)).data.lecturerId == request.auth.uid ||
          (resource.data.studentId == request.auth.uid)
        );
        
        // CREATE: Allow if user is the lecturer OR an enrolled student.
        allow create: if request.auth != null && (
            ( // Student condition
              exists(/databases/$(database)/documents/units/$(unitId)/enrolledStudents/$(request.auth.uid)) &&
              request.resource.data.studentId == request.auth.uid
            ) || 
            ( // Lecturer condition
              get(/databases/$(database)/documents/units/$(unitId)).data.lecturerId == request.auth.uid
            )
        );

        // Attendance records are immutable.
        allow update, delete: if false;
      }
    }
  }
}
